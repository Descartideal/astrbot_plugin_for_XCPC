{
  "admin_setting": {
    "description": "管理员设置",
    "type": "object",
    "items": {
      "enable": {
        "description": "插件开关",
        "type": "bool",
        "hint": "插件总开关，默认打开；若关闭则会阻断所有功能",
        "default": true
      },
      "API key": {
        "description": "API key",
        "type": "list",
        "items": {
          "type": "string"
        },
        "hint": "Codeforces API key 列表，留空表示不配置",
        "default": []
      },
      "Admin ID": {
        "description": "管理员 ID",
        "type": "list",
        "items": {
          "type": "string"
        },
        "hint": "管理员列表，仅列表中的 ID 才可调用管理员指令，留空表示不配置",
        "default": []
      }
    }
  },
  "contest_setting": {
    "description": "比赛推送设置",
    "type": "object",
    "items": {
      "contest_number": {
        "description": "单次查询获取的比赛数量",
        "type": "int",
        "hint": "表示查询比赛列表时，最多返回的比赛数量，默认为 5",
        "slider": {
          "min": 1,
          "max": 10,
          "step": 1
        },
        "default": 5
      },
      "contest_push_time": {
        "description": "每日定时推送 Codeforces 比赛信息",
        "type": "string",
        "hint": "预留配置项，留空表示不启用定时推送，格式为 HH:MM，24 小时制，冒号为半角字符。时间须带有前导零，例如早上八点零三，表示为 08:03，晚上十一点十一，表示为 23:11",
        "default": ""
      },
      "contest_push_sessions": {
        "description": "比赛信息推送会话",
        "type": "list",
        "items": {
          "type": "string"
        },
        "hint": "需要接收比赛自动推送的会话 ID 列表，与 astrbot 会话 ID 格式统一。留空表示不推送",
        "default": []
      }
    }
  },
  "luogu_setting": {
    "description": "洛谷提交记录设置",
    "type": "object",
    "items": {
      "cookie": {
        "description": "洛谷 Cookie",
        "type": "string",
        "hint": "用于查询提交记录。请从已登录洛谷的浏览器请求中复制完整 Cookie，仅保存在本机配置中，切勿提交到 GitHub 或发送到群聊。",
        "default": ""
      },
      "submission_number": {
        "description": "默认显示的提交数量",
        "type": "int",
        "hint": "使用 /提交洛谷 且未指定数量时返回的记录条数",
        "slider": {"min": 1, "max": 10, "step": 1},
        "default": 5
      }
    }
  },
  "loop_time": {
    "description": "插件轮询时间",
    "type": "int",
    "hint": "表示两次自动查询提交记录的间隔，单位为秒，一般推荐 300 - 600",
    "slider": {
      "min": 100,
      "max": 3600,
      "step": 100
    },
    "default": 600
  }
}
